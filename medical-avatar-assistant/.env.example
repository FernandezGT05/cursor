# Beyond Presence API (server only — never expose to the browser)
# Generate at https://app.bey.chat/settings
BEY_API_KEY=

# Optional: use an existing agent from your dashboard
BEY_AGENT_ID=

# Optional: force a specific avatar when auto-provisioning
BEY_AVATAR_ID=

# Agent display name (used when auto-creating)
BEY_AGENT_NAME=dr.vita

# Set to false to require a pre-created agent
AUTO_PROVISION_AGENT=true

PORT=3001
CLIENT_ORIGIN=http://localhost:5173
